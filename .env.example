# Discord Bot Token & OAuth2 Credentials (from https://discord.com/developers/applications)
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Render Application URL & OAuth2 Callback
# In Render, this should match your service URL: https://your-service.onrender.com/auth/discord/callback
CALLBACK_URL=https://your-app-name.onrender.com/auth/discord/callback

# Session Secret (Generate a strong random 32+ char string)
SESSION_SECRET=a_very_strong_random_secret_string_render_2026

# Default Bot Settings
BOT_PREFIX=!
PORT=3000
NODE_ENV=production

# MongoDB URI (Optional for persistent session store across container restarts)
# Get a free cluster at https://mongodb.com/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/discord_bot?retryWrites=true&w=majority
